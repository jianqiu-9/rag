{
  "name": "interview-rag-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "docs:check": "node tools/check-docs.mjs",
    "format": "prettier --write src e2e tools *.ts *.json index.html",
    "format:check": "prettier --check src e2e tools *.ts *.json index.html"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "mermaid": "^11.4.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
