# 从项目根目录复制为 .env；真实密钥不可提交到版本控制。
DATABASE_URL=postgresql://rag:rag_local@127.0.0.1:5432/rag
POSTGRES_PASSWORD=rag_local
DATA_DIR=./data
MODEL_CACHE_DIR=./data/models
EMBEDDING_MODEL=google/embeddinggemma-300m
# 留空时读取 download-model 写出的 model-lock.json；也可显式填写 40 位提交 SHA。
EMBEDDING_REVISION=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
CHUNK_CHARS=700
CHUNK_OVERLAP=80
# 调试起点，尚未完成中文验收集标定。
SIMILARITY_THRESHOLD=0.5
TOP_K=8
MAX_UPLOAD_MB=10
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=3000
CONTEXT_TOKEN_BUDGET=8000
# 完整问答记录默认保留 30 天，后台每小时清理到期的终态记录。
AUDIT_RETENTION_DAYS=30
AUDIT_CLEANUP_INTERVAL_SECONDS=3600
WORKER_ENABLED=true
FRONTEND_ORIGIN=http://127.0.0.1:5173
